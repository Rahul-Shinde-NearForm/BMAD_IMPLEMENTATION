# OPD Management System — Environment Configuration
# =====================================================
# Database: PostgreSQL (self-hosted, free)
# =====================================================

ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=django-opd-clinic-secret-key-change-in-production-2024

# Database (PostgreSQL)
DB_ENGINE=postgres
DB_NAME=opd_management
DB_USER=opd_user
DB_PASSWORD=opd_secure_2024
DB_HOST=localhost
DB_PORT=5432

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1
