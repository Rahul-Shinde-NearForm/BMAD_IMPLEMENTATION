# ============================================================================
# Docker Deployment Configuration
# Template for environment variables in production
# ============================================================================

# ============================================================================
# Django Configuration
# ============================================================================

# Set to False in production
DEBUG=False

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=opd.clinic.local,192.168.1.100,opd-backend

# Django environment
ENVIRONMENT=production

# Compose profiles usage:
# - Development: COMPOSE_PROFILES=dev
# - Test runner: COMPOSE_PROFILES=test
# - Production/default stack: leave empty
COMPOSE_PROFILES=

# ============================================================================
# Database Configuration
# ============================================================================

DB_ENGINE=postgresql
DB_NAME=opd_management
DB_USER=opd_user
DB_PASSWORD=secure-password-here-change-this
DB_HOST=db
DB_PORT=5432

# Test database name (used when ENVIRONMENT=test)
TEST_DB_NAME=/tmp/test_db.sqlite3

# Optional: For external PostgreSQL
# DB_HOST=192.168.1.50
# DB_PORT=5432

# ============================================================================
# Frontend Configuration
# ============================================================================

# Frontend domain
FRONTEND_URL=http://opd.clinic.local
FRONTEND_PORT=80

# ============================================================================
# Backend Configuration
# ============================================================================

# Backend domain
BACKEND_URL=http://opd-backend:8000
BACKEND_API_URL=http://opd.clinic.local/api

# Number of Gunicorn workers (set to: (CPU cores × 2) + 1)
GUNICORN_WORKERS=3

# ============================================================================
# Redis Configuration (for caching/sessions)
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password

# ============================================================================
# Security Headers
# ============================================================================

# HTTPS enforcement
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CSP Policy (customize as needed)
CSP_DEFAULT_SRC=self
CSP_SCRIPT_SRC=self
CSP_STYLE_SRC=self unsafe-inline
CSP_IMG_SRC=self data https

# ============================================================================
# Email Configuration (for notifications)
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

DEFAULT_FROM_EMAIL=noreply@opd.clinic.local

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
SENTRY_DSN=  # Optional: for error tracking

# ============================================================================
# API Configuration
# ============================================================================

API_RATE_LIMIT=1000/hour
API_TIMEOUT=60

# ============================================================================
# Media Files
# ============================================================================

# Max upload size (in bytes) - 100MB
MAX_UPLOAD_SIZE=104857600

# ============================================================================
# Time Zone
# ============================================================================

TZ=Asia/Kolkata
DJANGO_TIME_ZONE=Asia/Kolkata

# ============================================================================
# Custom Settings
# ============================================================================

# Clinic name (for branding)
CLINIC_NAME="OPD Management System"

# Admin email
ADMIN_EMAIL=admin@opd.clinic.local

# ============================================================================
# Docker Compose Specific
# ============================================================================

# Image versions
POSTGRES_VERSION=15-alpine
NGINX_VERSION=1.25-alpine
REDIS_VERSION=7-alpine
PYTHON_VERSION=3.11-slim

# Container restart policy
RESTART_POLICY=unless-stopped
